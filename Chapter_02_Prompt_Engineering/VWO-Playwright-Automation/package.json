{
  "name": "vwo-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript POM framework for the VWO login page",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:valid": "playwright test tests/login-valid.spec.ts",
    "test:invalid": "playwright test tests/login-invalid.spec.ts",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
